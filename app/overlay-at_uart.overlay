 / {
	chosen {
		aliro,at-uart = &uart30;
	};

	aliro_at_uart_rx: aliro-at-uart-rx {
		compatible = "gpio-keys";
		aliro_at_uart_rx_pin: aliro_at_uart_rx_pin {
			gpios = <&gpio0 1 ( GPIO_PULL_UP | GPIO_ACTIVE_LOW )>;
		};
	};
};

&pinctrl {
	uart30_default: uart30_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
		};
	};

	uart30_sleep: uart30_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};
};

&uart30 {
	compatible = "nordic,nrf-uarte";
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart30_default>;
	pinctrl-1 = <&uart30_sleep>;
	pinctrl-names = "default", "sleep";
	/delete-property/ hw-flow-control;
};

&gpio0 {
	status = "okay";
	sense-edge-mask = <0x00000012>; /* P0.01, P0.04 */
};

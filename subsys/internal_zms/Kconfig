menuconfig DOOR_LOCK_INTERNAL_ZMS
	bool "Internal ZMS Storage"
	select ZMS
	select FLASH
	select FLASH_MAP
	select PSA_WANT_GENERATE_RANDOM
	select PSA_WANT_KEY_TYPE_CHACHA20
	select PSA_WANT_ALG_CHACHA20_POLY1305
	select HW_UNIQUE_KEY
	select HW_UNIQUE_KEY_RANDOM
	select HW_UNIQUE_KEY_WRITE_ON_CRYPTO_INIT
	depends on DT_HAS_NORDIC_RRAM_CONTROLLER_ENABLED
	help
	  Enable Internal ZMS Storage.

if DOOR_LOCK_INTERNAL_ZMS

module = DOOR_LOCK_INTERNAL_ZMS
module-str = Door Lock Internal ZMS Storage
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

config  DOOR_LOCK_INTERNAL_ZMS_MAX_DATA_SIZE
	int "Maximum data size (bytes)"
	range 1 65535
	default 1024
	help
	  Maximum data size in bytes for the internal ZMS storage objects.

config DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION
	bool "Enable rollback protection"
	depends on SETTINGS
	select TRUSTED_STORAGE if (!PSA_SSF_CRYPTO_CLIENT && !BUILD_WITH_TFM)
	select PSA_PROTECTED_STORAGE if (TRUSTED_STORAGE && !PSA_SSF_CRYPTO_CLIENT && !BUILD_WITH_TFM)
	default y
	help
	  Enable rollback protection for the internal ZMS storage.
	  The device unique ID is stored in PSA Protected Storage (internal flash).

if DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION

config DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION_SETTINGS_PREFIX
	string "Settings prefix"
	default "izm"
	help
		Prefix for the settings keys for the rollback protection.

config DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION_UNIQUE_ID_SIZE
	int "Unique ID size (bytes)"
	default 8
	help
		Size of the unique ID in bytes for the rollback protection.

config DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION_UNIQUE_ID_UID
	hex "Unique ID UID"
	default 0x00000005FFFFFFFE
	help
		PSA Protected Storage UID for the device Unique ID (internal flash).
		This must be distinct from CONFIG_DOOR_LOCK_EXTERNAL_NVS_ROLLBACK_PROTECTION_UNIQUE_ID_UID.

endif # DOOR_LOCK_INTERNAL_ZMS_ROLLBACK_PROTECTION

config DOOR_LOCK_INTERNAL_ZMS_SHELL
	bool "Shell commands for Internal ZMS"
	depends on SHELL
	help
	  Enable shell commands for the Internal ZMS storage.

endif # DOOR_LOCK_INTERNAL_ZMS

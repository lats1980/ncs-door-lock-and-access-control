&pinctrl {
	spi21_default: spi21_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 11)>,
				<NRF_PSEL(SPIM_MISO, 1, 12)>;
		};
	};

	spi21_sleep: spi21_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
				<NRF_PSEL(SPIM_MOSI, 1, 11)>,
				<NRF_PSEL(SPIM_MISO, 1, 12)>;
			low-power-enable;
		};
	};
};

&spi21 {
	compatible = "nordic,nrf-spim";
	status = "okay";

	/* Chip select of the SR150 is entry 0 (reg = <0>) */
	cs-gpios = <&gpio2 4 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";

	uwb_sr150: uwb-sr150@0 {
		compatible = "nxp,sr150";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		spi-cs-setup-delay-ns = <1000>;
		spi-cs-hold-delay-ns = <1000>;
		irq-gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		wakeup-gpios = <&gpio2 0 GPIO_ACTIVE_HIGH>;
		en-gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

/* P1.13 is the SPI clock */
&button0 {
	status = "disabled";
};

&gpio0 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};
